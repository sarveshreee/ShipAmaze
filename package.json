{
  "name": "shipamaze",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.0",
    "concurrently": "^9.0.1"
  },
  "scripts": {
    "dev": "concurrently -n frontend,backend -c cyan,magenta \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "powershell -NoProfile -Command \"cd frontend; npm run dev\"",
    "dev:backend": "powershell -NoProfile -Command \"cd backend; npm run dev\"",
    "build": "npm run build:all",
    "build:frontend": "powershell -NoProfile -Command \"cd frontend; npm run build\"",
    "build:backend": "powershell -NoProfile -Command \"cd backend; npm run build\"",
    "build:all": "powershell -NoProfile -Command \"cd backend; npm run build; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; cd ..\\frontend; npm run build\"",
    "start:api": "powershell -NoProfile -Command \"cd backend; npm start\"",
    "start:pm2": "pm2 start ecosystem.config.cjs",
    "lint": "powershell -NoProfile -Command \"cd frontend; npm run lint\"",
    "typecheck": "powershell -NoProfile -Command \"cd backend; npm run typecheck; cd ..\\frontend; npm run typecheck\"",
    "test": "powershell -NoProfile -Command \"cd frontend; npm run test\"",
    "test:backend": "powershell -NoProfile -Command \"cd backend; npm run test\"",
    "test:all": "powershell -NoProfile -Command \"cd backend; npm run test; cd ..\\frontend; npm run test\"",
    "test:e2e": "powershell -NoProfile -Command \"npx playwright test\""
  }
}
