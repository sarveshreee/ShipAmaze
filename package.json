{
  "name": "shipamaze",
  "private": true,
  "type": "module",
  "devDependencies": {
    "concurrently": "^9.0.1"
  },
  "scripts": {
    "dev": "concurrently -n frontend,backend -c cyan,magenta \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "powershell -NoProfile -Command \"cd frontend; npm run dev\"",
    "dev:backend": "powershell -NoProfile -Command \"cd backend; npm run dev\"",
    "build": "powershell -NoProfile -Command \"cd frontend; npm run build\"",
    "lint": "powershell -NoProfile -Command \"cd frontend; npm run lint\"",
    "test": "powershell -NoProfile -Command \"cd frontend; npm run test\""
  }
}
