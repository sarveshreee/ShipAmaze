# --- Core (required everywhere) ---
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/shipamaze

# Auth & API security
JWT_SECRET=change-me-to-a-long-random-string-in-production
CORS_ORIGIN=http://localhost:8080
# Comma-separated for multiple frontends, e.g. https://app.example.com,https://staging.example.com
ENCRYPTION_SECRET=change-me-to-a-long-random-encryption-secret

# OAuth redirect after Shopify install (defaults to first CORS_ORIGIN in production if unset)
FRONTEND_URL=http://localhost:8080

# Optional: global JSON body size (default 1mb in production, 10mb in development)
# JSON_BODY_LIMIT=1mb

# Optimized product images (WebP). Defaults to ./uploads/products
# PRODUCT_UPLOADS_DIR=/var/data/shipamaze/uploads/products

# Cloudinary (product image CDN — required for uploads and optimized thumbnails)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: enable admin batch migration endpoints on Render (no shell access needed)
# CLOUDINARY_MIGRATION_ENABLED=true

# Optional: Mongo connection retries (default 8)
# MONGODB_CONNECT_RETRIES=8

# --- Shopify (importerr-style: each user enters Client ID + Secret in the UI) ---
# Server-wide callback URL — add this exact URL to EACH merchant's custom app in Shopify Admin.
SHOPIFY_REDIRECT_URI=http://localhost:5000/api/shopify/callback
# Optional legacy single-app keys (webhooks fallback only; connect uses per-user credentials)
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_customers,write_customers,read_fulfillments,write_fulfillments,write_locations,read_locations,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders,read_orders,write_orders,read_products,write_products
# Merchant custom app → Allowed redirection URL must include SHOPIFY_REDIRECT_URI above.
# Webhook delivery URL (defaults to {SHOPIFY_REDIRECT_URI origin}/api/shopify/webhooks)
# SHOPIFY_WEBHOOK_URL=https://shipamaze.onrender.com/api/shopify/webhooks
# Path on the frontend after OAuth (default /dropshipper/channels)
# SHOPIFY_POST_CONNECT_PATH=/dropshipper/channels

# --- Velocity Shipping (optional; set VELOCITY_ENABLED=true in production to require credentials) ---
VELOCITY_ENABLED=false
VELOCITY_BASE_URL=https://shazam.velocity.in
VELOCITY_USERNAME=
VELOCITY_PASSWORD=
VELOCITY_TOKEN_CACHE_TTL_MINUTES=1320
# VELOCITY_REQUEST_TIMEOUT_MS=45000
# VELOCITY_DEBUG_LOGS=0
# Required for real NDR actions. Ask Velocity for the exact re-attempt/RTO endpoint.
# Example format: /custom/api/v1/ndr/action
# VELOCITY_NDR_ACTION_ENDPOINT=

# --- Lorrigo Shipping (optional; set LORRIGO_ENABLED=true to activate) ---
LORRIGO_ENABLED=false
LORRIGO_BASE_URL=https://app.lorrigo.com/api
LORRIGO_EMAIL=
LORRIGO_PASSWORD=
# LORRIGO_TOKEN_CACHE_TTL_MINUTES=120
# LORRIGO_REQUEST_TIMEOUT_MS=45000
# LORRIGO_MAX_TRANSIENT_RETRIES=2
# LORRIGO_DEBUG_LOGS=0

# --- Multi-provider courier discovery (Phase 4) ---
# velocity | lorrigo | both  (default velocity — existing behavior)
# COURIER_DISCOVERY_MODE=velocity
# Optional successful-response cache TTL in seconds (0 = disabled). Failures are never cached.
# COURIER_SERVICEABILITY_CACHE_TTL_SECONDS=60

# Lorrigo background status sync interval (ms). Minimum 30000. Default 300000 (5 min).
# LORRIGO_STATUS_SYNC_INTERVAL_MS=300000
# Lorrigo NDR sync interval (ms). Minimum 60000. Default 600000 (10 min).
# LORRIGO_NDR_SYNC_INTERVAL_MS=600000

# --- Rate limits (optional overrides) ---
# RATE_LIMIT_AUTH_MAX=40
# RATE_LIMIT_PASSWORD_RESET_MAX=12
# RATE_LIMIT_SHOPIFY_CALLBACK_MAX=40
# RATE_LIMIT_SHOPIFY_CONNECT_MAX=30
# RATE_LIMIT_PUBLIC_TRACK_MAX=200

# --- Transactional email ---
#
# PRODUCTION ON RENDER (free tier blocks SMTP ports 25/465/587 — use HTTP API):
#
# Option A — Brevo (recommended; free tier, verify sender email in Brevo dashboard)
# BREVO_API_KEY=xkeysib-...
# MAIL_FROM_EMAIL=sarveshreee@gmail.com
#
# Option B — Resend (verify your domain at resend.com for arbitrary recipients)
# RESEND_API_KEY=re_...
# RESEND_FROM=onboarding@resend.dev
#
# LOCAL DEV — Gmail App Password via Nodemailer SMTP:
EMAIL_FROM=
EMAIL_PASS=
# Gmail SMTP (explicit host/port — more reliable on Render than Nodemailer service shorthand)
# GMAIL_SMTP_HOST=smtp.gmail.com
# GMAIL_SMTP_PORT=587
# If 587 times out on your host, try GMAIL_SMTP_PORT=465
# SMTP_CONNECTION_TIMEOUT_MS=30000
# SMTP_GREETING_TIMEOUT_MS=30000
# SMTP_SOCKET_TIMEOUT_MS=60000
# SMTP_FORCE_IPV4=true
# Optional display From (defaults to ShipAmaze <EMAIL_FROM> if unset)
# MAIL_FROM_NAME=ShipAmaze
# MAIL_FROM_EMAIL=
#
# Same transport, alternate names (used only if EMAIL_FROM / EMAIL_PASS are unset):
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
#
# Optional branding in templates
# BRAND_LOGO_URL=https://example.com/logo.png
# BRAND_SUPPORT_EMAIL=support@example.com
# BRAND_WEBSITE_URL=https://example.com
# BRAND_PRIMARY_COLOR=#2563eb
#
# Fallback: custom SMTP
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=ShipAmaze <noreply@example.com>
# Optional dev: SMTP_VERIFY=true
# Signup email OTP (minutes / max verify attempts / resend cooldown seconds)
OTP_EXPIRY_MINUTES=5
# EMAIL_VERIFICATION_OTP_MINUTES=10
# EMAIL_VERIFICATION_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60
# PASSWORD_RESET_MAX_ATTEMPTS=8
# RATE_LIMIT_EMAIL_OTP_VERIFY_MAX=30
# RATE_LIMIT_EMAIL_OTP_SEND_MAX=8
# RATE_LIMIT_EMAIL_OTP_RESEND_MAX=8






