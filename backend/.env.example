# * `FRONTEND_URL=https://shipamaze.vercel.app`
# * `SHOPIFY_SCOPES=read_customers,write_customers,read_fulfillments,write_fulfillments,write_locations,read_locations,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders,read_third_party_fulfillment_orders,write_third_party_fulfillment_orders,read_assigned_fulfillment_orders,write_assigned_fulfillment_orders,read_orders,write_orders,read_products,write_products`
# * `SHOPIFY_POST_CONNECT_PATH=/dropshipper/channels`

# ---

# ### Frontend Environment Variables**

# **Localhost (Vercel / local)**

# * `VITE_API_BASE_URL=http://localhost:5000/api`

# **Live (Vercel / production)**

# * `VITE_API_BASE_URL=https://shipamaze.onrender.com/api`

# --- Partner Courier API (external API keys) ---
# Kill switch for /api/partner/v1 routes (default true)
PARTNER_API_ENABLED=true
# Production (multi-instance): REQUIRED — do not use memory
# PARTNER_RATE_LIMIT_STORE=mongo
# PARTNER_RATE_LIMIT_PASS_ON_STORE_ERROR=true
# Production when Lorrigo/Ekart partner billing applies:
# PARTNER_WALLET_BILLING_ENABLED=true
# PARTNER_API_BASE_PATH=/api/partner/v1
# PARTNER_GENERAL_RATE_LIMIT_MAX=120
# PARTNER_GENERAL_RATE_LIMIT_WINDOW_MS=60000
# PARTNER_BOOKING_RATE_LIMIT_MAX=10
# PARTNER_BOOKING_RATE_LIMIT_WINDOW_MS=60000
# PARTNER_AUTH_FAILURE_RATE_LIMIT_MAX=30
# PARTNER_AUTH_FAILURE_RATE_LIMIT_WINDOW_MS=60000