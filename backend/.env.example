# --- Core (required everywhere) ---
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/shipamaze

# Deployment label for staging infrastructure gate (/api/health.environment).
# Staging hosts MUST set this to staging (or another non-production value).
# Do NOT set to production/prod/live on staging.
# DEPLOYMENT_ENV=staging
# APP_ENV=staging
# GIT_COMMIT=  (or RENDER_GIT_COMMIT — hardening SHA exposed on /api/health)

# --- Staging infrastructure gate (read-only; never point at production) ---
# STAGING_API_BASE=https://your-staging-api.example.com
# STAGING_EXPECTED_COMMIT=<hardening-sha>
# STAGING_EMAIL=
# STAGING_PASSWORD=
# STAGING_ORDER_ID=
# STAGING_FRONTEND_URL=https://your-staging-frontend.example.com
# STAGING_FRONTEND_API_BASE=https://your-staging-api.example.com
# STAGING_EXPECTED_MONGO_DB=shipamaze_staging
# STAGING_PRODUCTION_MONGO_DB=shipamaze
# STAGING_ALLOW_NODE_ENV_PRODUCTION=true

# Auth & API security
JWT_SECRET=change-me-to-a-long-random-string-in-production
CORS_ORIGIN=http://localhost:8080
# Comma-separated for multiple frontends, e.g. https://app.example.com,https://staging.example.com
ENCRYPTION_SECRET=change-me-to-a-long-random-encryption-secret

# OAuth redirect after Shopify install (defaults to first CORS_ORIGIN in production if unset)
FRONTEND_URL=http://localhost:8080

# Optional: global JSON body size (default 1mb in production, 10mb in development)
# JSON_BODY_LIMIT=1mb

# Optimized product images (WebP). Defaults to ./uploads/products
# PRODUCT_UPLOADS_DIR=/var/data/shipamaze/uploads/products

# Cloudinary (product image CDN — required for uploads and optimized thumbnails)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: enable admin batch migration endpoints on Render (no shell access needed)
# CLOUDINARY_MIGRATION_ENABLED=true

# Optional: Mongo connection retries (default 8)
# MONGODB_CONNECT_RETRIES=8

# --- Shopify (importerr-style: each user enters Client ID + Secret in the UI) ---
# Server-wide callback URL — add this exact URL to EACH merchant's custom app in Shopify Admin.
SHOPIFY_REDIRECT_URI=http://localhost:5000/api/shopify/callback
# Optional legacy single-app keys (webhooks fallback only; connect uses per-user credentials)
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_customers,write_customers,read_fulfillments,write_fulfillments,write_locations,read_locations,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders,read_third_party_fulfillment_orders,write_third_party_fulfillment_orders,read_assigned_fulfillment_orders,write_assigned_fulfillment_orders,read_orders,write_orders,read_products,write_products
# Merchant custom app → Allowed redirection URL must include SHOPIFY_REDIRECT_URI above.
# Webhook delivery URL (defaults to {SHOPIFY_REDIRECT_URI origin}/api/shopify/webhooks)
# SHOPIFY_WEBHOOK_URL=https://shipamaze.onrender.com/api/shopify/webhooks
# Path on the frontend after OAuth (default /dropshipper/channels)
# SHOPIFY_POST_CONNECT_PATH=/dropshipper/channels

# --- Velocity Shipping ---
# True kill switch: false → no register, sync, discovery, or new bookings.
# Unset defaults to enabled (backward compatible). Set true in production with credentials.
VELOCITY_ENABLED=true
VELOCITY_BASE_URL=https://shazam.velocity.in
VELOCITY_USERNAME=
VELOCITY_PASSWORD=
VELOCITY_TOKEN_CACHE_TTL_MINUTES=1320
# VELOCITY_REQUEST_TIMEOUT_MS=45000
# VELOCITY_DEBUG_LOGS=0
# Required for real NDR actions. Ask Velocity for the exact re-attempt/RTO endpoint.
# Example format: /custom/api/v1/ndr/action
# VELOCITY_NDR_ACTION_ENDPOINT=

# --- Lorrigo Shipping (optional; set LORRIGO_ENABLED=true to activate) ---
# Production (Render): set these in the dashboard — .env is NOT deployed with git.
# Without LORRIGO_ENABLED=true + email/password, Lorrigo never appears in courier selection.
LORRIGO_ENABLED=false
LORRIGO_BASE_URL=https://app.lorrigo.com/api
LORRIGO_EMAIL=
# If the password contains #, quote it in .env files: LORRIGO_PASSWORD="Amaze@123#"
LORRIGO_PASSWORD=
# LORRIGO_TOKEN_CACHE_TTL_MINUTES=120
# LORRIGO_REQUEST_TIMEOUT_MS=45000
# LORRIGO_MAX_TRANSIENT_RETRIES=2
# LORRIGO_DEBUG_LOGS=0
# LORRIGO_ALWAYS_LOG_REQUESTS=false
# LORRIGO_MAX_CONCURRENT_REQUESTS=6
# VELOCITY_MAX_CONCURRENT_REQUESTS=6

# --- Ekart Logistics / Durin (optional; set EKART_ENABLED=true to activate) ---
# No pickup sync — ShipAmaze Pickup is mapped to source/return_location at booking.
EKART_ENABLED=false
EKART_BASE_URL=https://api.ekartlogistics.com
# Full Authorization header value, e.g. Basic d2VidGVjOk...
EKART_AUTHORIZATION=
EKART_MERCHANT_CODE=TEC
EKART_TIMEOUT_MS=30000
EKART_RETRY_COUNT=2
EKART_CREATE_ENDPOINT=/v2/shipments/create
EKART_TRACK_ENDPOINT=/v2/shipments/track
EKART_CREATE_LARGE_ENDPOINT=/shipments/large/create
EKART_TRACK_LARGE_ENDPOINT=/shipments/large/track
# EKART_RTO_CREATE_ENDPOINT=/v3/shipments/rto/create
# EKART_CANCEL_RVP_ENDPOINT=/v3/shipments/cancel_rvp
# EKART_REVERSE_SERVICE_CODE=RETURNS_SMART_CHECK
# EKART_AUTH_ENDPOINT=/auth/token
# EKART_SERVICE_CODE=REGULAR
# EKART_GOODS_CATEGORY=NON_ESSENTIAL
# EKART_TOKEN_CACHE_TTL_MINUTES=40
# EKART_STATUS_SYNC_INTERVAL_MS=300000
# Optional Critical Updates receiver (polling remains source of truth)
# EKART_WEBHOOKS_ENABLED=false
# EKART_WEBHOOK_SECRET=
# Cancel/RTO/Cancel RVP (Durin v3) — keep false until Ekart confirms for your merchant
# EKART_CANCEL_ENABLED=false
# EKART_DEBUG_LOGS=0

# --- MongoDB pool (Phase 9) ---
# MONGODB_MAX_POOL_SIZE=20
# MONGODB_MIN_POOL_SIZE=2
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
# MONGODB_MAX_IDLE_TIME_MS=60000
# MONGODB_SOCKET_TIMEOUT_MS=45000

# --- Multi-provider courier discovery (Phase 4) ---
# velocity | lorrigo | ekart | both
# When unset: "both" if LORRIGO_ENABLED or EKART_ENABLED, else "velocity"
COURIER_DISCOVERY_MODE=both
# Optional successful-response cache TTL in seconds (0 = disabled). Failures are never cached.
# COURIER_SERVICEABILITY_CACHE_TTL_SECONDS=60
# COURIER_SERVICEABILITY_CACHE_MAX_ENTRIES=500

# Lorrigo background status sync interval (ms). Minimum 30000. Default 300000 (5 min).
# LORRIGO_STATUS_SYNC_INTERVAL_MS=300000
# Lorrigo NDR sync interval (ms). Minimum 60000. Default 600000 (10 min).
# LORRIGO_NDR_SYNC_INTERVAL_MS=600000

# --- Rate limits (optional overrides) ---
# RATE_LIMIT_AUTH_MAX=40
# RATE_LIMIT_PASSWORD_RESET_MAX=12
# RATE_LIMIT_SHOPIFY_CALLBACK_MAX=40
# RATE_LIMIT_SHOPIFY_CONNECT_MAX=30
# RATE_LIMIT_PUBLIC_TRACK_MAX=200
# POST /api/courier/shipments (per user)
# RATE_LIMIT_COURIER_BOOKING_MAX=10
# RATE_LIMIT_COURIER_BOOKING_WINDOW_MS=60000

# --- Distributed sync locks (multi-instance) ---
# Prefer Redis when available (optional: npm i ioredis). Else Mongo distributed_locks collection.
# REDIS_URL=redis://127.0.0.1:6379
# DISTRIBUTED_LOCK_TTL_MS=240000

# --- Transactional email ---
#
# PRODUCTION ON RENDER (free tier blocks SMTP ports 25/465/587 — use HTTP API):
#
# Option A — Brevo (recommended; free tier, verify sender email in Brevo dashboard)
# BREVO_API_KEY=xkeysib-...
# MAIL_FROM_EMAIL=sarveshreee@gmail.com
#
# Option B — Resend (verify your domain at resend.com for arbitrary recipients)
# RESEND_API_KEY=re_...
# RESEND_FROM=onboarding@resend.dev
#
# LOCAL DEV — Gmail App Password via Nodemailer SMTP:
EMAIL_FROM=
EMAIL_PASS=
# Gmail SMTP (explicit host/port — more reliable on Render than Nodemailer service shorthand)
# GMAIL_SMTP_HOST=smtp.gmail.com
# GMAIL_SMTP_PORT=587
# If 587 times out on your host, try GMAIL_SMTP_PORT=465
# SMTP_CONNECTION_TIMEOUT_MS=30000
# SMTP_GREETING_TIMEOUT_MS=30000
# SMTP_SOCKET_TIMEOUT_MS=60000
# SMTP_FORCE_IPV4=true
# Optional display From (defaults to ShipAmaze <EMAIL_FROM> if unset)
# MAIL_FROM_NAME=ShipAmaze
# MAIL_FROM_EMAIL=
#
# Same transport, alternate names (used only if EMAIL_FROM / EMAIL_PASS are unset):
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
#
# Optional branding in templates
# BRAND_LOGO_URL=https://example.com/logo.png
# BRAND_SUPPORT_EMAIL=support@example.com
# BRAND_WEBSITE_URL=https://example.com
# BRAND_PRIMARY_COLOR=#2563eb
#
# Fallback: custom SMTP
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=ShipAmaze <noreply@example.com>
# Optional dev: SMTP_VERIFY=true
# Signup email OTP (minutes / max verify attempts / resend cooldown seconds)
OTP_EXPIRY_MINUTES=5
# EMAIL_VERIFICATION_OTP_MINUTES=10
# EMAIL_VERIFICATION_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60
# PASSWORD_RESET_MAX_ATTEMPTS=8
# RATE_LIMIT_EMAIL_OTP_VERIFY_MAX=30
# RATE_LIMIT_EMAIL_OTP_SEND_MAX=8
# RATE_LIMIT_EMAIL_OTP_RESEND_MAX=8






# ### Backend Environment Variables**

