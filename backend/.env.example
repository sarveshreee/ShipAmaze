PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/shipamaze
JWT_SECRET=change-me-to-a-long-random-string-in-production
CORS_ORIGIN=http://localhost:8080
ENCRYPTION_SECRET=change-me-to-a-long-random-encryption-secret

# Shopify OAuth — create an app at https://partners.shopify.com
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here
SHOPIFY_SCOPES=read_orders,read_products,read_customers
SHOPIFY_REDIRECT_URI=http://localhost:5000/api/shopify/callback
