# --- Core (required everywhere) ---
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/shipamaze

# Auth & API security
JWT_SECRET=change-me-to-a-long-random-string-in-production
CORS_ORIGIN=http://localhost:8080
# Comma-separated for multiple frontends, e.g. https://app.example.com,https://staging.example.com
ENCRYPTION_SECRET=change-me-to-a-long-random-encryption-secret

# OAuth redirect after Shopify install (defaults to first CORS_ORIGIN in production if unset)
FRONTEND_URL=http://localhost:8080

# Optional: global JSON body size (default 1mb in production, 10mb in development)
# JSON_BODY_LIMIT=1mb

# Optional: Mongo connection retries (default 8)
# MONGODB_CONNECT_RETRIES=8

# --- Shopify (importerr-style: each user enters Client ID + Secret in the UI) ---
# Server-wide callback URL — add this exact URL to EACH merchant's custom app in Shopify Admin.
SHOPIFY_REDIRECT_URI=http://localhost:5000/api/shopify/callback
# Optional legacy single-app keys (webhooks fallback only; connect uses per-user credentials)
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders,write_orders,read_products,write_products,read_locations,write_locations,read_customers,write_customers
# Merchant custom app → Allowed redirection URL must include SHOPIFY_REDIRECT_URI above.
# Webhook delivery URL (defaults to {SHOPIFY_REDIRECT_URI origin}/api/shopify/webhooks)
# SHOPIFY_WEBHOOK_URL=https://shipamaze.onrender.com/api/shopify/webhooks
# Path on the frontend after OAuth (default /dropshipper/channels)
# SHOPIFY_POST_CONNECT_PATH=/dropshipper/channels

# --- Velocity Shipping (optional; set VELOCITY_ENABLED=true in production to require credentials) ---
VELOCITY_ENABLED=false
VELOCITY_BASE_URL=https://shazam.velocity.in
VELOCITY_USERNAME=
VELOCITY_PASSWORD=
VELOCITY_TOKEN_CACHE_TTL_MINUTES=1320
# VELOCITY_REQUEST_TIMEOUT_MS=45000
# VELOCITY_DEBUG_LOGS=0

# --- Rate limits (optional overrides) ---
# RATE_LIMIT_AUTH_MAX=40
# RATE_LIMIT_PASSWORD_RESET_MAX=12
# RATE_LIMIT_SHOPIFY_CALLBACK_MAX=40
# RATE_LIMIT_SHOPIFY_CONNECT_MAX=30
# RATE_LIMIT_PUBLIC_TRACK_MAX=200

# --- Transactional email (Nodemailer). If unset, emails are skipped (no OTP in logs). ---
#
# Simplest: Gmail address + App Password (checked first)
EMAIL_FROM=
EMAIL_PASS=
# Optional display From (defaults to ShipAmaze <EMAIL_FROM> if unset)
# MAIL_FROM_NAME=ShipAmaze
# MAIL_FROM_EMAIL=
#
# Same transport, alternate names (used only if EMAIL_FROM / EMAIL_PASS are unset):
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
#
# Optional branding in templates
# BRAND_LOGO_URL=https://example.com/logo.png
# BRAND_SUPPORT_EMAIL=support@example.com
# BRAND_WEBSITE_URL=https://example.com
# BRAND_PRIMARY_COLOR=#2563eb
#
# Fallback: custom SMTP
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=ShipAmaze <noreply@example.com>
# Optional dev: SMTP_VERIFY=true
# Signup email OTP (minutes / max verify attempts / resend cooldown seconds)
OTP_EXPIRY_MINUTES=5
# EMAIL_VERIFICATION_OTP_MINUTES=10
# EMAIL_VERIFICATION_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60
# PASSWORD_RESET_MAX_ATTEMPTS=8
# RATE_LIMIT_EMAIL_OTP_VERIFY_MAX=30
# RATE_LIMIT_EMAIL_OTP_SEND_MAX=8
# RATE_LIMIT_EMAIL_OTP_RESEND_MAX=8






# ### Backend Environment Variables**

# **Localhost (development / Render or local API)**

# * `SHOPIFY_REDIRECT_URI=http://localhost:5000/api/shopify/callback`
# * `SHOPIFY_WEBHOOK_URL=http://localhost:5000/api/shopify/webhooks`
# * `FRONTEND_URL=http://localhost:8080`
# * `SHOPIFY_SCOPES=read_orders,write_orders,read_products,write_products,read_locations,write_locations,read_customers,write_customers`
# * `SHOPIFY_POST_CONNECT_PATH=/dropshipper/channels`

# **Live (production / Render)**

# * `SHOPIFY_REDIRECT_URI=https://shipamaze.onrender.com/api/shopify/callback`
# * `SHOPIFY_WEBHOOK_URL=https://shipamaze.onrender.com/api/shopify/webhooks`
# * `FRONTEND_URL=https://shipamaze.vercel.app`
# * `SHOPIFY_SCOPES=read_orders,write_orders,read_products,write_products,read_locations,write_locations,read_customers,write_customers`
# * `SHOPIFY_POST_CONNECT_PATH=/dropshipper/channels`

