{
  "name": "shipamaze-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed:users": "tsx src/scripts/seedUsers.ts",
    "seed:single-user": "tsx src/scripts/seedSingleUser.ts",
    "seed:admin-vendor": "tsx src/scripts/seedAdminVendor.ts",
    "clear:test-orders": "tsx src/scripts/clearTestOrders.ts",
    "migrate:product-images": "tsx src/scripts/migrateProductImages.ts",
    "migrate:cloudinary": "tsx scripts/migrateExistingImagesToCloudinary.ts",
    "typecheck": "tsc --noEmit",
    "staging:gate": "tsx src/scripts/stagingInfrastructureGate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude '**/integration/**'",
    "test:integration:partner": "vitest run src/integration/partner.api.security.integration.test.ts src/integration/partner.api.idempotency.integration.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0",
    "multer": "^2.2.0",
    "nodemailer": "^6.9.16",
    "pdf-lib": "^1.17.1",
    "streamifier": "^0.1.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.17",
    "@types/streamifier": "^0.1.2",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
