# Public API base URL (must include the /api prefix used by the Express app).
# Local / ngrok: relative path — Vite proxies /api → http://127.0.0.1:5000
VITE_API_BASE_URL=/api

# Production (example): set in Vercel → Settings → Environment Variables
# VITE_API_BASE_URL=https://your-shipamaze-api.onrender.com/api

# Velocity merchant UI (not the API host — backend uses VELOCITY_BASE_URL=https://shazam.velocity.in)
VITE_VELOCITY_DASHBOARD_URL=https://dashboard.velocity.in
# Warehouse / pickup address settings — "Open Velocity Dashboard" on pickup link cards
VITE_VELOCITY_WAREHOUSE_URL=https://dashboard.velocity.in/shipping/settings/address
